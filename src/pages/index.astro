---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HomePosts from "../components/HomePosts.astro";
import ColorScript from "../components/ColorScript.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const posts = await getCollection("posts");
---

<!doctype html>
<html lang="en-us">
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <body>
    <Header title={SITE_TITLE} />
    <main id="main">

      <section class="hero">
        <div class="hero-label">// Computer Scientist · IBM · Islamabad, Pakistan</div>
        <h1 class="hero-name">Syed Asad<br />Zaman</h1>
        <p class="hero-bio">
          I'm a computer scientist — the specific problem changes more than the approach: reinforcement
          learning, differential privacy, and for the last two years, AI systems built to survive
          production traffic, not just a benchmark. Three of those are shipped and running real
          workloads at IBM.
        </p>
        <p class="hero-current">
          Currently: applying that same instinct to enterprise asset data at IBM — read the system
          before touching it, build the smallest thing that actually fixes what's broken. Writing
          about what holds up once a system leaves the whiteboard.
        </p>
        <div class="hero-links">
          <a href="/about">about me →</a>
          <a href="mailto:essayyzed@gmail.com">essayyzed@gmail.com</a>
          <a href="https://github.com/essayyzed" target="_blank" rel="noopener">github</a>
          <a href="https://www.linkedin.com/in/essayyzed/" target="_blank" rel="noopener">linkedin</a>
        </div>
      </section>

      <section class="nav-cards">
        <a href="/about" class="nav-card">
          <span class="nav-card-key">[01]</span>
          <h2>About</h2>
          <p>How I got here, what I've shipped, and how I think about AI</p>
        </a>
        <a href="/posts" class="nav-card">
          <span class="nav-card-key">[02]</span>
          <h2>Writing</h2>
          <p>On production AI, LLMs, and what nobody tells you in tutorials</p>
        </a>
        <a href="/projects" class="nav-card">
          <span class="nav-card-key">[03]</span>
          <h2>Projects</h2>
          <p>GenAI systems built for real users with measurable impact</p>
        </a>
        <a href="/maximo" class="nav-card">
          <span class="nav-card-key">[04]</span>
          <h2>Maximo</h2>
          <p>IBM MAS development — automation scripting and EAM guides</p>
        </a>
      </section>

      <section class="posts-section">
        <div class="section-header">
          <span class="section-label">// latest posts</span>
          <a href="/posts" class="section-link">all posts →</a>
        </div>
        <HomePosts allPosts={posts} />
      </section>

    </main>
    <Footer />
    <ColorScript />
  </body>
</html>

<style>
  .hero { margin: 2.5rem 0 3rem; }

  .hero-label {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .hero-name {
    font-size: clamp(2.4rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--fg);
    margin-bottom: 1.1rem;
  }

  .hero-bio {
    max-width: 54ch;
    font-size: var(--text-base);
    color: var(--fg);
    line-height: 1.7;
    margin-bottom: 0.6rem;
  }

  .hero-current {
    max-width: 54ch;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: var(--text-sm);
  }
  .hero-links a {
    color: var(--fg-muted);
    text-decoration: none;
    transition: color var(--transition);
  }
  .hero-links a:hover { color: var(--accent); }

  /* ── Nav cards ── */
  .nav-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 2rem 0 3rem;
    background: var(--border);
  }

  .nav-card {
    display: block;
    padding: 1.25rem 1.5rem;
    background: var(--bg);
    text-decoration: none;
    color: var(--fg);
    transition: background var(--transition);
  }
  .nav-card:hover { background: var(--bg-alt); text-decoration: none; }

  .nav-card-key {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 0.35rem;
  }
  .nav-card h2 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 0.3rem;
  }
  .nav-card p {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Posts section ── */
  .posts-section { margin: 0.5rem 0 2rem; }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .section-label {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    letter-spacing: 0.08em;
  }

  .section-link {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    text-decoration: none;
    transition: color var(--transition);
  }
  .section-link:hover { color: var(--accent); }

  @media (max-width: 520px) {
    .nav-cards { grid-template-columns: 1fr; }
    .hero-name { font-size: 2.1rem; }
  }
</style>
